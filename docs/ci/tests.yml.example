name: tests

on:
  push:
    branches: [main, 'fix/**']
  pull_request:

permissions:
  contents: read

jobs:
  pytest:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.13'
          cache: pip
      - name: Install locked dependencies
        run: python -m pip install -q -r requirements.lock
      - name: Verify dependencies
        run: python -m pip check
      - name: Test isolated database and services
        run: python -m pytest server/tests -q --disable-warnings
      - name: Check whitespace
        run: git diff --check
