    wx.set_weather_setting(h.conn, "weather.rules_enabled", True)
    client = h.login_as("operator")
    response = client.post(f'/api/v1/weather/rules/{rule["id"]}/test', json={"controller_id": ctrl["id"]})
    print("F02 preview HTTP/global rules before/after:", response.status_code, True, wx.get_weather_setting(h.conn, "weather.rules_enabled", None))

    for box in ("AUDIT-A", "AUDIT-B"):
        h.controller(box)
        with h.conn:
            h.conn.execute("UPDATE controllers SET connection_status='online' WHERE box_id=?", (box,))
    h.cfg.raw["mqtt"].update(command_timeout_sec=0.15, command_retries=1)
    # Production uses db_path for logging; mirror that, avoiding harness fallback.
    h.cmd._db_path = str(h.db_path)
    records = []
    first_published = threading.Event()
    original_publish = h.mqtt.publish
    def publish(topic, payload, **kwargs):
        records.append((time.monotonic(), topic))
        if "AUDIT-A" in topic:
            first_published.set()
        return original_publish(topic, payload, **kwargs)
    h.mqtt.publish = publish
    first = threading.Thread(target=lambda: h.cmd.send_command("AUDIT-A", "stop_all", {}))
    first.start()
    if not first_published.wait(2):
        raise RuntimeError("First command was not published")
    requested = time.monotonic()
    second = threading.Thread(target=lambda: h.cmd.send_command("AUDIT-B", "stop_all", {}))
    second.start()
    first.join(3)
    second.join(3)
    matches = [t for t, topic in records if "AUDIT-B" in topic]
    print("F01 second-controller stop publication delay with 0.15s timeout/1 retry:", round(matches[0] - requested, 3))
finally:
    h.close()
    h.conn.close()
